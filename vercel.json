{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/api/:path*",
      "destination": "https://architecture-stack.vercel.app/api/:path*",
      "permanent": false
    },
    {
      "source": "/progress/config",
      "destination": "https://architecture-stack.vercel.app/api/progress-sync?route=config",
      "permanent": false
    },
    {
      "source": "/progress/state",
      "destination": "https://architecture-stack.vercel.app/api/progress-sync?route=state",
      "permanent": false
    },
    {
      "source": "/health",
      "destination": "https://architecture-stack.vercel.app/api/assistant-bridge?route=health",
      "permanent": false
    },
    {
      "source": "/config",
      "destination": "https://architecture-stack.vercel.app/api/assistant-bridge?route=config",
      "permanent": false
    },
    {
      "source": "/config/runtime",
      "destination": "https://architecture-stack.vercel.app/api/assistant-bridge?route=config-runtime",
      "permanent": false
    },
    {
      "source": "/metrics",
      "destination": "https://architecture-stack.vercel.app/api/assistant-bridge?route=metrics",
      "permanent": false
    },
    {
      "source": "/assistant/query",
      "destination": "https://architecture-stack.vercel.app/api/assistant-bridge?route=assistant-query",
      "permanent": false
    },
    {
      "source": "/ask",
      "destination": "https://architecture-stack.vercel.app/api/assistant-bridge?route=assistant-query",
      "permanent": false
    }
  ]
}
